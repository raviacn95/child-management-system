VITE_APP_NAME=Willow
VITE_API_URL=/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ENABLE_PWA=true
VITE_ENABLE_MSW=true
VITE_FEATURE_LEARNING_CHANNELS=true
VITE_SENTRY_DSN=
# Optional first-party analytics endpoint. Collection is disabled until a user opts in.
VITE_ANALYTICS_ENDPOINT=
# Public affiliate tracking IDs only. Never put Flipkart/Amazon API secrets here.
VITE_SHOP_API=
VITE_FLIPKART_AFFILIATE_ID=
VITE_AMAZON_ASSOCIATE_TAG=
VITE_MEESHO_AFFILIATE_ID=
VITE_CUELINKS_PUB_ID=
VITE_ADMITAD_CODE=
# Hosted checkout links only (Razorpay Payment Pages / Subscriptions or Stripe Payment Links). No payment keys here.
VITE_PLUS_CHECKOUT_URL=
# Optional yearly Plus page. Price shown in the app is ₹1,990 (ten months, two free).
VITE_PLUS_YEARLY_CHECKOUT_URL=
VITE_PACKS_CHECKOUT_URL=
# Where "Book a demo" requests go: an https form endpoint, or a sales WhatsApp number / email as fallback.
VITE_LEADS_ENDPOINT=
VITE_SALES_WHATSAPP=
VITE_SALES_EMAIL=
# Server-only middleware values. Never prefix these with VITE_ or ship them to the browser.
GROK_API_KEY=
GROK_MODEL=grok-3-mini
