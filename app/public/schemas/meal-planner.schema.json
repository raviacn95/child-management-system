{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://willow.care/schema/meal-planner.json",
  "title": "Willow child meal planner",
  "description": "age + BMI category → pediatric nutrient targets → daily meals. Plug this into a mealPlanner service. Energy is stored as growth fuel, never shown as a calorie ceiling.",
  "type": "object",
  "required": ["schemaVersion", "ageBands", "bmiOverlays", "recipes"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "source": { "type": "string" },
    "ageBands": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/ageBand" }
    },
    "bmiOverlays": {
      "type": "object",
      "required": ["infant", "under", "healthy", "watch", "high"],
      "additionalProperties": { "$ref": "#/$defs/bmiOverlay" }
    },
    "recipes": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/recipe" }
    }
  },
  "$defs": {
    "mealAgeBand": { "type": "string", "enum": ["0-2", "2-5", "5-8", "8-12"] },
    "bmiBand": { "type": "string", "enum": ["infant", "under", "healthy", "watch", "high"] },
    "slot": { "type": "string", "enum": ["breakfast", "lunch", "snack", "dinner"] },
    "dietTag": {
      "type": "string",
      "enum": ["vegetarian", "egg", "jain", "nut-free", "dairy-free", "lactose-free"]
    },
    "nutrients": {
      "type": "object",
      "required": ["energyKcal", "proteinG", "calciumMg", "ironMg", "vitaminDIU", "fiberG"],
      "properties": {
        "energyKcal": { "type": "number", "minimum": 0, "description": "Internal growth-fuel estimate. Do not display as a restriction." },
        "proteinG": { "type": "number", "minimum": 0 },
        "calciumMg": { "type": "number", "minimum": 0 },
        "ironMg": { "type": "number", "minimum": 0 },
        "vitaminDIU": { "type": "number", "minimum": 0 },
        "fiberG": { "type": "number", "minimum": 0 }
      }
    },
    "ageBand": {
      "type": "object",
      "required": ["id", "ageMinMonths", "ageMaxMonths", "label", "targets"],
      "properties": {
        "id": { "$ref": "#/$defs/mealAgeBand" },
        "ageMinMonths": { "type": "integer", "minimum": 0 },
        "ageMaxMonths": { "type": "integer", "minimum": 0 },
        "label": { "type": "string" },
        "focus": { "type": "array", "items": { "type": "string" } },
        "targets": { "$ref": "#/$defs/nutrients" },
        "note": { "type": "string" }
      }
    },
    "bmiOverlay": {
      "type": "object",
      "required": ["growthCue", "energyAdjKcal", "extraSnack"],
      "properties": {
        "growthCue": { "type": "string" },
        "energyAdjKcal": { "type": "number" },
        "extraSnack": { "type": "boolean" },
        "playMinutes": { "type": "integer", "minimum": 0 }
      }
    },
    "ingredient": {
      "type": "object",
      "required": ["item", "qty", "unit", "grocery"],
      "properties": {
        "item": { "type": "string" },
        "qty": { "type": "number" },
        "unit": { "type": "string" },
        "grocery": { "type": "string" }
      }
    },
    "recipe": {
      "type": "object",
      "required": ["id", "name", "slot", "ageBands", "diet", "allergens", "ingredients", "portionByBand", "nutrients"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slot": { "$ref": "#/$defs/slot" },
        "ageBands": { "type": "array", "items": { "$ref": "#/$defs/mealAgeBand" }, "minItems": 1 },
        "diet": { "type": "array", "items": { "$ref": "#/$defs/dietTag" } },
        "allergens": { "type": "array", "items": { "type": "string" } },
        "avoidIf": { "type": "array", "items": { "type": "string" } },
        "swap": { "type": "string" },
        "tip": { "type": "string" },
        "ingredients": { "type": "array", "items": { "$ref": "#/$defs/ingredient" } },
        "portionByBand": {
          "type": "object",
          "required": ["0-2", "2-5", "5-8", "8-12"],
          "properties": {
            "0-2": { "type": "number" },
            "2-5": { "type": "number" },
            "5-8": { "type": "number" },
            "8-12": { "type": "number" }
          }
        },
        "nutrients": { "$ref": "#/$defs/nutrients" },
        "keywords": { "type": "array", "items": { "type": "string" } }
      }
    },
    "planRequest": {
      "description": "POST /api/meal-planner/plan — age, BMI category → daily meals → nutrient targets",
      "type": "object",
      "required": ["children"],
      "properties": {
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["ageYears"],
            "properties": {
              "childId": { "type": "string" },
              "childName": { "type": "string" },
              "ageYears": { "type": "number", "minimum": 0, "maximum": 18 },
              "sex": { "type": "string" },
              "heightCm": { "type": "number" },
              "weightKg": { "type": "number" },
              "allergies": { "type": "array", "items": { "type": "string" } },
              "dietType": { "type": "string" },
              "foodPreferences": { "type": "string" }
            }
          }
        },
        "filters": {
          "type": "array",
          "items": { "$ref": "#/$defs/dietTag" }
        }
      }
    }
  }
}
