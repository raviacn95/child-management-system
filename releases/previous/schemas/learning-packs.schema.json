{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://willow.care/schema/learning-packs.json",
  "title": "Willow age-banded learning packs",
  "description": "age range → curated channel list → playlist link. Plug this into a learningPacks service or table.",
  "type": "object",
  "required": ["schemaVersion", "packs"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/channel" },
      "description": "Optional channel registry (normalized table). If omitted, hydrate from your channels store."
    },
    "packs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/pack" }
    }
  },
  "$defs": {
    "ageBand": { "type": "string", "enum": ["2-5", "5-8", "8-12"] },
    "interest": {
      "type": "string",
      "enum": ["animals", "art", "math", "music", "science", "stories", "movement", "space", "history"]
    },
    "channel": {
      "type": "object",
      "required": ["id", "name", "interests", "description", "youtubeUrl", "playlistUrl"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "handle": { "type": "string" },
        "interests": { "type": "array", "items": { "$ref": "#/$defs/interest" } },
        "description": { "type": "string" },
        "youtubeUrl": { "type": "string", "format": "uri" },
        "playlistUrl": { "type": "string", "format": "uri", "description": "Official channel playlists (autoplay off)." },
        "youtubeKids": { "type": "boolean" },
        "adLight": { "type": "boolean" },
        "autoplaySafe": { "type": "boolean" },
        "coViewingTip": { "type": "string" }
      }
    },
    "pack": {
      "type": "object",
      "required": ["id", "ageBand", "ageMin", "ageMax", "label", "focus", "channelIds", "playlistUrl"],
      "properties": {
        "id": { "type": "string" },
        "ageBand": { "$ref": "#/$defs/ageBand" },
        "ageMin": { "type": "integer", "minimum": 0, "maximum": 18 },
        "ageMax": { "type": "integer", "minimum": 0, "maximum": 18 },
        "label": { "type": "string" },
        "focus": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "featuredChannelIds": { "type": "array", "items": { "type": "string" } },
        "channelIds": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "playlistUrl": { "type": "string", "format": "uri" },
        "anekalTip": { "type": "string" }
      }
    },
    "hydratedPack": {
      "description": "API response shape: GET /api/learning-packs",
      "type": "object",
      "required": ["id", "ageBand", "ageMin", "ageMax", "label", "focus", "playlistUrl", "channels"],
      "properties": {
        "id": { "type": "string" },
        "ageBand": { "$ref": "#/$defs/ageBand" },
        "ageMin": { "type": "integer" },
        "ageMax": { "type": "integer" },
        "label": { "type": "string" },
        "focus": { "type": "array", "items": { "type": "string" } },
        "playlistUrl": { "type": "string", "format": "uri" },
        "anekalTip": { "type": "string" },
        "featuredChannelIds": { "type": "array", "items": { "type": "string" } },
        "channels": { "type": "array", "items": { "$ref": "#/$defs/channel" } }
      }
    }
  }
}
