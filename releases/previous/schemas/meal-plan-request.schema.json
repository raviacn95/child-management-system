{
  "$id": "https://willow.care/schema/meal-plan-request.json",
  "title": "Willow family meal plan request",
  "description": "age + measures → BMI category → daily meals → pediatric nutrient targets. Energy is growth fuel, never a calorie ceiling.",
  "type": "object",
  "required": ["children"],
  "properties": {
    "children": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ageYears"],
        "properties": {
          "childId": { "type": "string" },
          "childName": { "type": "string" },
          "ageYears": { "type": "number", "minimum": 0, "maximum": 18 },
          "sex": { "type": "string" },
          "heightCm": { "type": "number" },
          "weightKg": { "type": "number" },
          "allergies": { "type": "array", "items": { "type": "string" } },
          "dietType": { "type": "string" },
          "foodPreferences": { "type": "string" }
        }
      }
    },
    "filters": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["vegetarian", "egg", "jain", "nut-free", "dairy-free", "lactose-free"]
      }
    }
  }
}
