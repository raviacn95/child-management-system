{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://willow.care/schema/horizons.json",
  "title": "Willow horizon-expansion activities",
  "description": "15 evidence-based activities (Piaget, Montessori, WHO/UNICEF) mapped to Grow at home → Skills → Activities. Daily tasks depend on age band and BMI percentile overlay.",
  "type": "object",
  "required": ["schemaVersion", "ageBands", "bmiOverlays", "activities"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "source": { "type": "string" },
    "ageBands": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/ageBand" }
    },
    "bmiOverlays": {
      "type": "object",
      "required": ["infant", "under", "healthy", "watch", "high"],
      "additionalProperties": { "$ref": "#/$defs/bmiOverlay" }
    },
    "activities": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": { "$ref": "#/$defs/activity" }
    }
  },
  "$defs": {
    "horizonBand": { "type": "string", "enum": ["2-5", "6-9", "10-13"] },
    "bmiBand": { "type": "string", "enum": ["infant", "under", "healthy", "watch", "high"] },
    "skillId": {
      "type": "string",
      "enum": ["language", "numeracy", "motor", "fineMotor", "social", "music", "art", "science", "focus", "leadership"]
    },
    "domain": {
      "type": "string",
      "enum": ["cognitive", "physical", "social", "emotional", "creative"]
    },
    "ageBand": {
      "type": "object",
      "required": ["id", "ageMinYears", "ageMaxYears", "label", "science", "activityIds"],
      "properties": {
        "id": { "$ref": "#/$defs/horizonBand" },
        "ageMinYears": { "type": "number" },
        "ageMaxYears": { "type": "number" },
        "label": { "type": "string" },
        "science": { "type": "string" },
        "activityIds": { "type": "array", "items": { "type": "string" }, "minItems": 5, "maxItems": 5 }
      }
    },
    "bmiOverlay": {
      "type": "object",
      "required": ["cue", "boostIds", "minutesAdj"],
      "properties": {
        "cue": { "type": "string" },
        "boostIds": { "type": "array", "items": { "type": "string" } },
        "minutesAdj": { "type": "integer" }
      }
    },
    "activity": {
      "type": "object",
      "required": ["id", "n", "name", "ageBand", "skillId", "domains", "minutes", "why", "todayTask"],
      "properties": {
        "id": { "type": "string" },
        "n": { "type": "integer", "minimum": 1, "maximum": 15 },
        "name": { "type": "string" },
        "ageBand": { "$ref": "#/$defs/horizonBand" },
        "skillId": { "$ref": "#/$defs/skillId" },
        "domains": { "type": "array", "items": { "$ref": "#/$defs/domain" }, "minItems": 1 },
        "minutes": { "type": "integer", "minimum": 5 },
        "why": { "type": "string" },
        "todayTask": { "type": "string" },
        "infantTask": { "type": "string" },
        "materials": { "type": "array", "items": { "type": "string" } }
      }
    },
    "planRequest": {
      "description": "POST /api/horizons/plan — age + BMI → today's actionable tasks",
      "type": "object",
      "required": ["ageYears"],
      "properties": {
        "childId": { "type": "string" },
        "childName": { "type": "string" },
        "ageYears": { "type": "number", "minimum": 0, "maximum": 18 },
        "bmiBand": { "$ref": "#/$defs/bmiBand" },
        "percentile": { "type": "number" },
        "date": { "type": "string" },
        "completedIds": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
