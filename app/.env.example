VITE_APP_NAME=Willow
VITE_API_URL=/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ENABLE_PWA=true
VITE_ENABLE_MSW=true
VITE_FEATURE_LEARNING_CHANNELS=true
VITE_SENTRY_DSN=
# Optional first-party analytics endpoint. Collection is disabled until a user opts in.
VITE_ANALYTICS_ENDPOINT=
# Public affiliate tracking IDs only. Never put Flipkart/Amazon API secrets here.
VITE_SHOP_API=
VITE_FLIPKART_AFFILIATE_ID=
VITE_AMAZON_ASSOCIATE_TAG=
VITE_MEESHO_AFFILIATE_ID=
VITE_CUELINKS_PUB_ID=
VITE_ADMITAD_CODE=
# Hosted checkout links only (Razorpay Payment Pages / Subscriptions or Stripe Payment Links). No payment keys here.
VITE_PLUS_CHECKOUT_URL=
# Optional yearly Plus page. Price shown in the app is ₹1,990 (ten months, two free).
VITE_PLUS_YEARLY_CHECKOUT_URL=
VITE_PACKS_CHECKOUT_URL=
# Where "Book a demo" requests go: an https form endpoint, or a sales WhatsApp number / email as fallback.
VITE_LEADS_ENDPOINT=
VITE_SALES_WHATSAPP=
VITE_SALES_EMAIL=
# Ask Willow AI helper: the public https URL of the willow-agent Supabase Edge Function
# (https://<project>.supabase.co/functions/v1/willow-agent). Not a secret. Empty = device-only answers.
VITE_AGENT_URL=
# Server-only values for middleware/.env.local and the willow-agent function. Never prefix these with VITE_.
# AI_PROVIDER: ollama (default), groq, gemini, xai, or qwen3 (the offline model on this PC).
# With an Ollama key the model is gpt-oss:120b. On this PC's Ollama app it is gpt-oss:120b-cloud.
# Either name works; the app picks the one the host expects. qwen3:latest is fully offline.
# AI_API_KEY, SUPABASE_ACCESS_TOKEN, and SUPABASE_DB_PASSWORD are GitHub Actions secrets.
# SUPABASE_PROJECT_REF and VITE_AGENT_URL are GitHub Actions variables. Do not commit real values.
AI_PROVIDER=ollama
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
