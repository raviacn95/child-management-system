{
  "$id": "https://willow.care/schema/horizons-plan-request.json",
  "title": "Willow horizon daily plan request",
  "description": "ageYears + BMI band → today's Grow at home activities (15-option catalog).",
  "type": "object",
  "required": ["ageYears"],
  "properties": {
    "childId": { "type": "string" },
    "childName": { "type": "string" },
    "ageYears": { "type": "number", "minimum": 0, "maximum": 18 },
    "bmiBand": { "type": "string", "enum": ["infant", "under", "healthy", "watch", "high"] },
    "percentile": { "type": "number" },
    "date": { "type": "string" },
    "completedIds": { "type": "array", "items": { "type": "string" } }
  }
}
